{
  "name": "reconstructable-tile-layer-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm --recursive --sort --if-present build",
    "build:packages": "pnpm --filter \"./packages/**\" --sort --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck:workspace && pnpm test",
    "clean": "pnpm --recursive --sort --if-present clean && rimraf .turbo",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:root && pnpm --recursive --sort --if-present lint",
    "lint:root": "eslint .eslintrc.cjs rollup.config.mjs --ext .cjs --ext .mjs --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm --filter rtl-tile-plate-quadtree test",
    "typecheck": "pnpm build:packages && pnpm typecheck:workspace",
    "typecheck:workspace": "pnpm --recursive --sort --if-present typecheck"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "26.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "cesium": "1.119.0",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "rollup": "4.18.1",
    "rollup-plugin-typescript2": "0.36.0",
    "tslib": "2.6.3",
    "turbo": "2.0.6",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.0.5",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "rollup": "4"
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
