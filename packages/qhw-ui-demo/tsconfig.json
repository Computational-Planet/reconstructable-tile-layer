{
  "compilerOptions": {
    /* target、module一般都可以这么写 */
    "target": "ES2018", // 指定 ECMAScript 目标版本（ES9及之前都支持）
    "module": "ESNext", // 指定生成哪个模块系统代码
    "lib": ["ESNext", "DOM"], // 指定要包含在编译中的库文件
    "declaration": true,
    "declarationMap": true, // 为每个对应的 '.d.ts' 文件生成一个源映射
    "sourceMap": true, // 生成相应的 '.map' 文件
    "baseUrl": "./",
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, // 禁止对同一个文件的不一致的引用，确保文件名大小写一致性。
    "skipLibCheck": true, // 跳过声明文件的类型检查
    "paths": {
      "tslib": ["./node_modules/tslib/tslib.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/dist/**", "node_modules", "**/*.spec.ts"]//在 exclude 中添加了 node_modules 和 **/*.spec.ts，排除测试文件和第三方库。
}
