{
  "name": "rtl-tile-plate-quadtree",
  "version": "1.0.0",
  "description": "Tile-plate quadtree indexing for Reconstructable Tile Layer plate domains.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/es/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && rollup --config",
    "clean": "rimraf dist",
    "dev": "rollup --config --watch",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cesium",
    "gis",
    "polygon-clipping",
    "quadtree",
    "reconstructable-tile-layer",
    "tiles"
  ],
  "author": "Qiuhan Wang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerWQH2023/tile-processer-turborepo.git",
    "directory": "packages/rtl-tile-plate-quadtree"
  },
  "bugs": {
    "url": "https://github.com/RogerWQH2023/tile-processer-turborepo/issues"
  },
  "homepage": "https://github.com/RogerWQH2023/tile-processer-turborepo#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7"
  },
  "peerDependencies": {
    "cesium": "^1.119.0"
  }
}
