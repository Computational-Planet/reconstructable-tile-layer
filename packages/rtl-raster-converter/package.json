{
  "name": "rtl-raster-converter",
  "version": "0.1.0",
  "description": "Browser Worker conversion of local GeoTIFF and selected scientific raster slices to COG.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json && rollup --config rollup.workers.config.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "rtl-raster-source": "workspace:^"
  },
  "peerDependencies": {
    "gdal3.js": "2.8.1"
  },
  "peerDependenciesMeta": {
    "gdal3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "gdal3.js": "2.8.1"
  },
  "license": "ISC",
  "author": "Qiuhan Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Computational-Planet/reconstructable-tile-layer.git",
    "directory": "packages/rtl-raster-converter"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
