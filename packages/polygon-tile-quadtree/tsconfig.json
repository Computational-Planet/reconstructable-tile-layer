{
  "compilerOptions": {
    "moduleResolution": "node", // 引入Cesium时需要设置这一项
    "declaration": true,
    "baseUrl": "./",
    "outDir": "./dist",
    // ...其他 TypeScript 编译选项
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "tslib": ["./node_modules/tslib/tslib.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/dist/**"]
}
