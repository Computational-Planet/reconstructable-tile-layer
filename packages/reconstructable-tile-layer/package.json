{
  "name": "reconstructable-tile-layer",
  "version": "0.1.0",
  "description": "Browser-side Reconstructable Tile Layers for published Web tile services.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/es/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && rollup --config",
    "clean": "rimraf dist",
    "dev": "rollup --config --watch",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cesium",
    "gplates",
    "gis",
    "paleogeography",
    "plate-reconstruction",
    "reconstructable-tile-layer"
  ],
  "author": "Qiuhan Wang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerWQH2023/tile-processer-turborepo.git",
    "directory": "packages/reconstructable-tile-layer"
  },
  "bugs": {
    "url": "https://github.com/RogerWQH2023/tile-processer-turborepo/issues"
  },
  "homepage": "https://github.com/RogerWQH2023/tile-processer-turborepo#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "rtl-finite-rotation": "workspace:*",
    "rtl-tile-plate-quadtree": "workspace:*",
    "rtl-webgl-tile-processor": "workspace:*"
  },
  "peerDependencies": {
    "cesium": "^1.119.0"
  }
}
