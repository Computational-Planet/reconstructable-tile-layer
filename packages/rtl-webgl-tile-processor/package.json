{
  "name": "rtl-webgl-tile-processor",
  "version": "1.0.0",
  "description": "GPU masking and processed tile images for browser-side Reconstructable Tile Layers.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/es/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && rollup --config",
    "clean": "rimraf dist",
    "dev": "rollup --config --watch",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cesium",
    "gis",
    "tiles",
    "webgl",
    "reprojection",
    "reconstructable-tile-layer"
  ],
  "author": "Qiuhan Wang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computational-earth/reconstructable-tile-layer.git",
    "directory": "packages/rtl-webgl-tile-processor"
  },
  "bugs": {
    "url": "https://github.com/computational-earth/reconstructable-tile-layer/issues"
  },
  "homepage": "https://github.com/computational-earth/reconstructable-tile-layer#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "earcut": "3.0.1"
  },
  "peerDependencies": {
    "cesium": "^1.119.0"
  }
}
